// Configuración de despliegue en Cloudflare Workers (sitio estático).
// Cloudflare lee este archivo al conectar el repositorio: publica la carpeta raíz tal cual, sin compilar nada.
{
  "name": "herbalife",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./",
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  }
}
